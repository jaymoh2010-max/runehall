# Runehall environment options
# Copy to .env for Docker Compose or a loader such as `node --env-file=.env`.
# The container always listens on 3001; RUNEHALL_PORT controls the published host port.
# RUNEHALL_BIND defaults to loopback. Use 0.0.0.0 only for a trusted LAN without a proxy.
RUNEHALL_PORT=3001
RUNEHALL_BIND=127.0.0.1
PORT=3001
HOST=0.0.0.0

# production also disables pretty logging and enables the CSP by default.
# NODE_ENV=production

# Secure cookies are on by default behind HTTPS. Set to 0 only for plain-HTTP local testing.
COOKIE_SECURE=1

# Production default: on. Set to 1 in development to test the CSP, or 0 to disable.
# ENABLE_CSP=1

# Login/register attempts per IP per window.
# AUTH_RATE_LIMIT_MAX=30
# AUTH_RATE_LIMIT_WINDOW_MS=300000

# Uploads per IP per window.
# UPLOAD_RATE_LIMIT_MAX=60
# UPLOAD_RATE_LIMIT_WINDOW_MS=600000

# Extra allowed origins for state-changing requests, comma-separated.
# Same-origin requests do not need this.
# TRUSTED_ORIGINS=https://runehall.example.com

# Number of reverse-proxy hops to trust for client IPs. Use 1 for one Caddy/Nginx,
# 0 when exposing directly, or 2 for CDN + proxy.
# TRUST_PROXY_HOPS=1

# open | invite | closed. The first account is always allowed and becomes
# the administrator; runtime changes in Hall controls override this value.
# invite is the safe default for an internet-facing server; use open only on a trusted LAN.
REGISTRATION_MODE=invite

# One-time token required for the first (administrator) account when set.
# Set a long random value before first boot, use it on the registration form,
# then unset it and recreate the container.
# BOOTSTRAP_TOKEN=replace-with-a-long-random-value

# Audit retention in days. 0 keeps entries forever.
# AUDIT_RETENTION_DAYS=0

# Optional paths. Defaults are relative to the project root.
# DATA_DIR=./data
# DATABASE_PATH=./data/runehall.db
# COMPENDIUM_DIR=./data/compendium
# BACKUP_DIR=./backups
# BACKUP_SHIP_DIR=./shipped

# debug | info | warn | error
LOG_LEVEL=info
