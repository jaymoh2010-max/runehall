{
  "name": "runehall",
  "version": "0.1.0",
  "private": true,
  "description": "An all-in-one Pathfinder Second Edition table and character builder.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx scripts/start.mjs",
    "ingest": "node scripts/ingest-pf2e.mjs",
    "ingest:aon": "node scripts/ingest-aon-reference.mjs",
    "apply:data-overrides": "node scripts/apply-compendium-overrides.mjs",
    "verify:data": "node --env-file-if-exists=.env scripts/verify-compendium.mjs",
    "simulate": "tsx scripts/simulate-characters.ts 1000 --matrix --content --options --prereqs",
    "simulate:exhaustive": "tsx scripts/simulate-characters.ts --full 200",
    "simulate:feats": "tsx scripts/simulate-feat-classes.ts",
    "simulate:campaign": "tsx scripts/simulate-campaign.ts",
    "simulate:parties": "tsx scripts/simulate-campaign-parties.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "ship-backup": "node --env-file-if-exists=.env scripts/ship-backup.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "restore-drill": "node --env-file-if-exists=.env scripts/restore-drill.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "cleanup-assets": "node --env-file-if-exists=.env scripts/cleanup-assets.mjs",
    "audit-prune": "node scripts/prune-audit.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:headed": "npm run build && playwright test --headed",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:full": "npm run check && npm run smoke",
    "ingest:runes": "node scripts/ingest-runesmith-runes.mjs"
  },
  "keywords": [
    "pathfinder",
    "pf2e",
    "vtt",
    "character-builder"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.79.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sanitize-html": "^2.18.2",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
