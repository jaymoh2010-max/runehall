{
  "name": "runehall",
  "version": "0.1.0",
  "private": true,
  "description": "An all-in-one Pathfinder Second Edition table and character builder.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "ingest": "node scripts/ingest-pf2e.mjs",
    "verify:data": "node scripts/verify-compendium.mjs",
    "simulate": "tsx scripts/simulate-characters.ts 1000 --matrix --content --options --prereqs",
    "backup": "node scripts/backup.mjs",
    "ship-backup": "node scripts/ship-backup.mjs",
    "restore": "node scripts/restore.mjs",
    "restore-drill": "node scripts/restore-drill.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "cleanup-assets": "node scripts/cleanup-assets.mjs",
    "audit-prune": "node scripts/prune-audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:headed": "npm run build && playwright test --headed",
    "check": "npm run typecheck && npm test && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:full": "npm run check && npm run smoke"
  },
  "keywords": [
    "pathfinder",
    "pf2e",
    "vtt",
    "character-builder"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/static": "^10.1.8",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "concurrently": "^10.0.6",
    "fastify": "^5.12.8",
    "lucide-react": "^1.67.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.18.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
